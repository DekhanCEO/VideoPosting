# ─────────────────────────────────────────────────────────────
# VideoPosting — configuration (copiez ce fichier en .env)
# Tout est facultatif : sans clé d'API, l'application démarre en mode démo.
# Les identifiants peuvent aussi être saisis dans Paramètres (ces variables sont prioritaires).
# ─────────────────────────────────────────────────────────────

# URL publique HTTPS de l'application (redirections OAuth + téléchargement des vidéos par Instagram).
# En local, utilisez un tunnel : cloudflared tunnel --url http://localhost:3000  (ou ngrok http 3000)
PUBLIC_URL=

# Mot de passe d'accès à l'interface (fortement recommandé dès que l'app est exposée sur Internet)
APP_PASSWORD=

# Secret de signature (liens vidéo temporaires). Généré automatiquement si vide.
APP_SECRET=

# Dossier de stockage (base JSON + vidéos). Par défaut : ./data
DATA_DIR=

# ── YouTube (Google Cloud : YouTube Data API v3 + YouTube Analytics API) ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── TikTok (TikTok for Developers : Login Kit + Content Posting API) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Autorisations demandées (à activer dans votre app TikTok)
# TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.publish,video.upload

# ── Instagram (Meta for Developers) ──
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# "instagram" (connexion Instagram, nécessite PUBLIC_URL) ou "facebook" (Facebook Login, envoi direct)
INSTAGRAM_LOGIN_TYPE=instagram
META_GRAPH_VERSION=v24.0

# Déclencheur externe facultatif : GET /api/cron?secret=...&sync=1
CRON_SECRET=

# Chemins de ffmpeg / ffprobe (facultatif, utilisés pour analyser les vidéos que le navigateur ne lit pas)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
