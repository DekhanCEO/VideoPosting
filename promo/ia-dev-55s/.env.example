# Copiez ce fichier en .env (jamais commité) et renseignez vos clés.
# Sans clé, la voix est générée en local avec Piper (voix française fr_FR-siwis-medium).

# Voix off ElevenLabs (endpoint « with-timestamps » : les sous-titres sont calés sur ses timestamps)
ELEVENLABS_API_KEY=
# Optionnel : identifiant de voix et modèle (par défaut : voix multilingue, eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
