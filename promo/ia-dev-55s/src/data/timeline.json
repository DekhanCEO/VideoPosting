 "lines": [
  {
   "scene": "hook",
   "text": "Tu codes encore sans IA ?",
   "start": 0.26,
   "end": 1.746
  },
  {
   "scene": "hook",
   "text": "Tu perds des heures pour rien.",
   "start": 2.117,
   "end": 3.29
  },
  {
   "scene": "probleme",
   "text": "Un développeur passe souvent plus de temps sur le code répétitif, les bugs et la documentation que sur les fonctionnalités qui font la différence.",
   "start": 3.927,
   "end": 11.276
  },
  {
   "scene": "code",
   "text": "Formulaires, modèles de données, appels API : l'IA génère le squelette en quelques secondes, et toi tu te concentres sur la logique métier.",
   "start": 12.145,
   "end": 18.983
  },
  {
   "scene": "debug",
   "text": "Une erreur incompréhensible ?",
   "start": 20.799,
   "end": 22.099
  },
  {
   "scene": "debug",
   "text": "Colle le message dans l'IA : elle t'explique la cause et propose le correctif.",
   "start": 22.479,
   "end": 26.647
  },
  {
   "scene": "tests",
   "text": "Tests unitaires, documentation, commentaires : des tâches ingrates, automatisées en un prompt.",
   "start": 28.025,
   "end": 33.307
  },
  {
   "scene": "idee",
   "text": "Tu décris ton idée, l'IA t'aide à structurer le projet, coder les écrans et préparer la mise en ligne.",
   "start": 34.857,
   "end": 39.907
  },
  {
   "scene": "idee",
   "text": "Une application complète en quelques jours, là où il fallait des semaines.",
   "start": 40.287,
   "end": 43.55
  },
  {
   "scene": "bemol",
   "text": "L'IA ne remplace pas le développeur.",
   "start": 44.603,
   "end": 46.31
  },
  {
   "scene": "bemol",
   "text": "Elle amplifie celui qui sait ce qu'il fait.",
   "start": 46.662,
   "end": 48.392
  },
  {
   "scene": "cta",
   "text": "Dis-moi en commentaire ce que tu aimerais automatiser en premier.",
   "start": 49.693,
   "end": 52.607
  },
  {
   "scene": "cta",
   "text": "Et suis pour la suite !",
   "start": 52.987,
   "end": 53.986
  }
 ],
