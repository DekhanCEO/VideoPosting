{
  "name": "uplink-launch",
  "private": true,
  "version": "1.0.0",
  "description": "Vidéos Uplink (Remotion) : plan de lancement 5 s, visite guidée 64 s et version TikTok 15 s, téléphone en 3D CSS.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Launch out/uplink-launch.mp4",
    "render:tour": "remotion render src/index.ts Tour out/uplink-tour.mp4",
    "render:tiktok": "remotion render src/index.ts TikTok out/uplink-tiktok.mp4",
    "render:tiktok-plan-sequence": "remotion render src/index.ts TikTokPlanSequence out/uplink-tiktok-plan-sequence.mp4",
    "render:tiktok-signal": "remotion render src/index.ts TikTokSignal out/uplink-tiktok-signal.mp4",
    "render:tiktok-essentiel": "remotion render src/index.ts TikTokEssentiel out/uplink-tiktok-essentiel.mp4",
    "render:premiere": "remotion render src/index.ts TikTokPremiere out/uplink-premiere.mp4 --codec=h264 --crf=17 --audio-codec=aac --audio-bitrate=256k",
    "render:elan": "remotion render src/index.ts TikTokElan out/uplink-elan.mp4 --codec=h264 --crf=17 --audio-codec=aac --audio-bitrate=256k",
    "still": "remotion still src/index.ts Launch out/still.png --frame=149",
    "still:tour": "remotion still src/index.ts Tour out/tour.png --frame=1919",
    "typecheck": "tsc --noEmit",
    "render:pub": "remotion render UplinkPub out/uplink-pub.mp4",
    "sfx:pub": "python3 scripts/pub-sfx.py",
    "audio:premiere": "python3 scripts/premiere-audio.py out/premiere.wav && ffmpeg -y -loglevel error -i out/premiere.wav -c:a aac -b:a 256k public/premiere/premiere.m4a",
    "audio:elan": "python3 scripts/elan-audio.py out/elan.wav && ffmpeg -y -loglevel error -i out/elan.wav -c:a aac -b:a 256k public/elan/elan.m4a"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@remotion/cli": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
