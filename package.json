{
  "name": "videoposting",
  "version": "1.0.0",
  "private": true,
  "description": "Publiez la même vidéo sur TikTok, YouTube et Instagram depuis une seule interface.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:php": "node --test tests/php/integration.test.mjs",
    "test:node": "node --test tests/node/integration.test.mjs",
    "package:hosting": "node scripts/package-hosting.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:all": "node scripts/package-hosting.mjs && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
