# ─────────────────────────────────────────────────────────────────────────────
# {{APP}} — identifiants des plateformes
#
# Placez ce fichier HORS du dossier public du site (voir LISEZ-MOI.txt) :
# il ne doit jamais être accessible depuis le navigateur.
# Les valeurs renseignées ici sont prioritaires sur celles saisies dans l'application.
# Laissez vide ce que vous n'utilisez pas.
# Adresse de retour à déclarer partout : {{SITE}}{{BASE}}/api/callback.php
# ─────────────────────────────────────────────────────────────────────────────

# Twitch (connexion à {{APP}} + abonnés et revenus de la chaîne)
# https://dev.twitch.tv/console/apps — type de client : Confidentiel
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube (Google Cloud : YouTube Data API v3 + YouTube Analytics API, ID client « Application Web »)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (TikTok for Developers : Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram (Meta for Developers)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# instagram (connexion Instagram) ou facebook (via une Page Facebook)
INSTAGRAM_LOGIN_TYPE=instagram
META_GRAPH_VERSION=v24.0

# Facultatif : adresse publique forcée (si l'hébergement la détecte mal), ex. {{SITE}}{{BASE}}
PUBLIC_URL=
# Facultatif : secret de l'URL cron (sinon généré automatiquement)
CRON_SECRET=
